# ------------------------------------------------------------------
# Development environment variables (copy to a real env source; never commit real secrets).
# docker compose reads POSTGRES_* and RABBITMQ_* automatically.
# The .NET services read the ConnectionStrings__* and Security__* values when run on the host.
# ------------------------------------------------------------------

# --- Infrastructure (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- tuition-service ---
ConnectionStrings__TuitionDb=Host=localhost;Port=5432;Database=tuition_db;Username=postgres;Password=postgres

# --- otp-service ---
ConnectionStrings__OtpDb=Host=localhost;Port=5432;Database=otp_db;Username=postgres;Password=postgres

# --- notification-service ---
ConnectionStrings__NotificationDb=Host=localhost;Port=5432;Database=notification_db;Username=postgres;Password=postgres

# --- Service-to-service authentication (shared secret) ---
Security__InternalApi__ApiKey=dev-internal-key-change-me

# --- Event payload encryption (AES-256-GCM, base64, 32 bytes) ---
# Must be identical in otp-service and notification-service.
Security__EventEncryption__Key=NcrgFPcKEwQDuvR0SFaNrDmZTJSEMpD4qsMybIukus8=

# --- SMTP (MailHog in development) ---
Smtp__Host=localhost
Smtp__Port=1025
Smtp__EnableSsl=false
